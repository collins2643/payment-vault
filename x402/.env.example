# ---- Network ---------------------------------------------------------------
# testnet (default) or mainnet. Mainnet moves real USDC.
STELLAR_NETWORK=testnet

# ---- Payment destination ---------------------------------------------------
# A wallet (G...) with a USDC trustline, or the Payment Vault contract (C...).
# Current Testnet vault:
PAY_TO=CDGZHCOHFAM4UCIF5PQZSYK7WXPYD77BNT2YZNSHZRUTOY42EQUPNJ65

# ---- Facilitator -----------------------------------------------------------
# Testnet: free x402.org facilitator, no API key.
FACILITATOR_URL=https://www.x402.org/facilitator

# ---- Price -----------------------------------------------------------------
# Raw USDC units (7 decimals): 10000 = 0.001 USDC, 100000 = 0.01 USDC
PRICE_UNITS=10000

# ============================================================================
# MAINNET: replace the values above with these (set them as Railway variables,
# never commit real keys):
#
# STELLAR_NETWORK=mainnet
# PAY_TO=G...your-wallet-with-Circle-USDC-trustline
# FACILITATOR_URL=https://channels.openzeppelin.com/x402
# FACILITATOR_API_KEY=...   # generate at https://channels.openzeppelin.com/gen
# PRICE_UNITS=100000        # 0.01 USDC
# MAX_PRICE_UNITS=10000000  # safety ceiling, 1 USDC (optional)
#
# The vault contract is unaudited. To pay a mainnet vault (C...) anyway, add:
# ALLOW_UNAUDITED_VAULT=yes
# and keep balances small (withdraw often).
# Optional: STELLAR_RPC_URL=https://your-mainnet-rpc
# ============================================================================
