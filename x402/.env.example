# Payment destination: your Payment Vault contract (C...) or a wallet (G...)
# Current Testnet vault:
PAY_TO=CDGZHCOHFAM4UCIF5PQZSYK7WXPYD77BNT2YZNSHZRUTOY42EQUPNJ65
# testnet (default) or mainnet. Keep testnet until the contract is audited.
STELLAR_NETWORK=testnet
# Testnet payment service (free, no API key needed)
FACILITATOR_URL=https://www.x402.org/facilitator
# Mainnet only: set a mainnet facilitator and its key, e.g.
# FACILITATOR_URL=https://channels.openzeppelin.com/x402
# FACILITATOR_API_KEY=your-key-here
# 10000 = 0.001 USDC
PRICE_UNITS=10000
# Payments into the vault cost ~140,000 stroops in fees, over x402.org's 50,000 cap.
# Run the self-hosted facilitator (npm run facilitator) and point the server at it:
# FACILITATOR_URL=http://localhost:4022
# Wheat cent valuation API (coins/) prices in raw USDC units. Defaults shown.
# COIN_PRICE_MELT=10000
# COIN_PRICE_BULK=10000
# COIN_PRICE_KEYDATES=20000
# COIN_PRICE_SCENARIO=50000
# Optional copper spot source (expects JSON with a "price" field in USD/lb)
# COPPER_PRICE_URL=https://api.gold-api.com/price/HG
