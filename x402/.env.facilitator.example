# Settings for `npm run facilitator` (copy to .env.facilitator; never commit the real file).
# Account that pays settlement fees. Omit on testnet to use a throwaway Friendbot-funded key.
# FACILITATOR_SECRET=S...
STELLAR_NETWORK=testnet
# Fee ceiling per settlement in stroops (vault payments need ~140,000)
MAX_FEE_STROOPS=300000
# Required on mainnet. Use the same value as FACILITATOR_API_KEY in the server's .env.
# FACILITATOR_API_KEY=long-random-string
PORT=4022
